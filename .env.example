# .env.example
# Salin file ini menjadi .env untuk pengujian lokal: cp .env.example .env
# PERINGATAN: DILARANG MENG-COMMIT FILE .env YANG BERISI NILAI RAHASIA KE GIT!

# GitHub OAuth App Configuration (Wajib untuk login Admin di /admin)
# Dapatkan di: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sesi Cookie HMAC Signature Key (Minimal 32 karakter acak)
AUTH_SECRET=

# Kredensial Telemetri Notifikasi (Opsional jika sudah diatur via CMS)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_SERVER=https://ntfy.fmr.web.id
NTFY_TOPIC=agent
NTFY_AUTH_TOKEN=
