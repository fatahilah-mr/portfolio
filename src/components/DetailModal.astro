---
// src/components/DetailModal.astro
// Universal Accessible Pop-up Modal for Project Details & Certificate Transcripts
---

<dialog id="universal-detail-modal" class="detail-modal-dialog" aria-labelledby="modal-title">
  <div class="detail-modal-content">
    <!-- Header -->
    <div class="detail-modal-header">
      <div id="modal-category-badge" class="badge-tag">Kategori</div>
      <button id="modal-close-btn" class="detail-modal-close-btn" aria-label="Tutup Jendela Detail">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="detail-modal-body">
      <!-- Media Container -->
      <div class="modal-media-wrapper" id="modal-media-wrapper">
        <img id="modal-image-front" src="" alt="" class="modal-main-image" loading="eager" />
        <img id="modal-image-back" src="" alt="Transkrip Nilai" class="modal-main-image hidden" loading="eager" />
      </div>

      <!-- Transcript Flip Control (Shown for certs with back page) -->
      <div id="modal-transcript-controls" class="modal-transcript-bar hidden">
        <button id="modal-toggle-page-btn" class="btn btn-secondary btn-sm">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 16-4 4-4-4"/>
            <path d="M17 20V4"/>
            <path d="m3 8 4-4 4 4"/>
            <path d="M7 4v16"/>
          </svg>
          <span id="transcript-btn-text">
            <span class="lang-id">Lihat Halaman Belakang / Transkrip Nilai</span>
            <span class="lang-en">View Back Page / Grade Transcript</span>
          </span>
        </button>
      </div>

      <!-- Meta & Narrative Info -->
      <div class="modal-info-box">
        <h2 id="modal-title" class="modal-heading">Judul Item</h2>
        
        <p id="modal-desc" class="modal-description">Deskripsi teknis item...</p>

        <!-- Project Tags -->
        <div id="modal-tags-container" class="modal-tags hidden"></div>

        <!-- Project Documentation Link -->
        <div id="modal-actions-container" class="modal-actions hidden">
          <a id="modal-live-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span class="lang-id">Buka Dokumentasi & Demo</span>
            <span class="lang-en">Open Documentation & Demo</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  .modal-media-wrapper {
    position: relative;
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 480px;
  }

  .modal-main-image {
    max-width: 100%;
    max-height: 480px;
    object-fit: contain;
    display: block;
    transition: opacity 0.25s ease;
  }

  .modal-transcript-bar {
    display: flex;
    justify-content: center;
    padding: 4px 0;
  }

  .modal-info-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .modal-heading {
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.3;
  }

  .modal-description {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-muted);
    white-space: pre-line;
    margin: 0;
  }

  .modal-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  .modal-actions {
    margin-top: 12px;
  }

  .hidden {
    display: none !important;
  }
</style>

<script is:inline>
  (function initUniversalModal() {
    const dialog = document.getElementById('universal-detail-modal');
    if (!dialog) return;

    const closeBtn = document.getElementById('modal-close-btn');
    const catBadge = document.getElementById('modal-category-badge');
    const imgFront = document.getElementById('modal-image-front');
    const imgBack = document.getElementById('modal-image-back');
    const transcriptBar = document.getElementById('modal-transcript-controls');
    const togglePageBtn = document.getElementById('modal-toggle-page-btn');
    const titleEl = document.getElementById('modal-title');
    const descEl = document.getElementById('modal-desc');
    const tagsContainer = document.getElementById('modal-tags-container');
    const actionsContainer = document.getElementById('modal-actions-container');
    const liveLink = document.getElementById('modal-live-link');

    let isShowingBack = false;

    function closeModal() {
      dialog.close();
      document.body.style.overflow = '';
    }

    closeBtn?.addEventListener('click', closeModal);

    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
      if (!isInDialog) {
        closeModal();
      }
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeModal();
      }
    });

    // Toggle Front / Back image for certificates
    togglePageBtn?.addEventListener('click', () => {
      isShowingBack = !isShowingBack;
      imgFront?.classList.toggle('hidden', isShowingBack);
      imgBack?.classList.toggle('hidden', !isShowingBack);

      const btnText = togglePageBtn.querySelector('#transcript-btn-text');
      if (btnText) {
        if (isShowingBack) {
          btnText.innerHTML = '<span class="lang-id">Kembali ke Halaman Depan</span><span class="lang-en">Back to Front Page</span>';
        } else {
          btnText.innerHTML = '<span class="lang-id">Lihat Halaman Belakang / Transkrip Nilai</span><span class="lang-en">View Back Page / Grade Transcript</span>';
        }
      }
    });

    // Global Project Modal Opener
    window.openProjectModal = function(proj) {
      if (!proj) return;
      isShowingBack = false;
      transcriptBar?.classList.add('hidden');
      imgBack?.classList.add('hidden');
      imgFront?.classList.remove('hidden');

      if (catBadge) catBadge.textContent = proj.kategori || 'Website';
      if (imgFront) {
        imgFront.src = proj.link_gambar || '';
        imgFront.alt = proj.judul || '';
      }

      const isEn = document.documentElement.getAttribute('lang') === 'en';
      if (titleEl) titleEl.textContent = (isEn && proj.english_title) ? proj.english_title : proj.judul;
      if (descEl) descEl.textContent = (isEn && proj.english_desc) ? proj.english_desc : proj.deskripsi;

      // Tags
      if (tagsContainer) {
        const tags = Array.isArray(proj.tags) ? proj.tags : [];
        if (tags.length > 0) {
          tagsContainer.innerHTML = tags.map(t => `<span class="badge-tag">${t}</span>`).join('');
          tagsContainer.classList.remove('hidden');
        } else {
          tagsContainer.classList.add('hidden');
        }
      }

      // Link
      if (actionsContainer && liveLink) {
        if (proj.link_dokumentasi) {
          liveLink.href = proj.link_dokumentasi;
          actionsContainer.classList.remove('hidden');
        } else {
          actionsContainer.classList.add('hidden');
        }
      }

      document.body.style.overflow = 'hidden';
      dialog.showModal();
    };

    // Global Certificate Modal Opener
    window.openCertModal = function(cert) {
      if (!cert) return;
      isShowingBack = false;
      actionsContainer?.classList.add('hidden');
      tagsContainer?.classList.add('hidden');

      if (catBadge) catBadge.textContent = `${cert.penerbit} (${cert.tahun})`;
      if (imgFront) {
        imgFront.src = cert.url_gambar_depan || '';
        imgFront.alt = cert.nama_sertifikat || '';
        imgFront.classList.remove('hidden');
      }

      if (titleEl) titleEl.textContent = cert.nama_sertifikat || '';
      if (descEl) {
        descEl.textContent = `Penerbit: ${cert.penerbit} • Tahun: ${cert.tahun} • Tipe: Format ${cert.tipe || 'horizontal'}.`;
      }

      // Transcript handling
      if (cert.tombol_transkrip === 'ada' && cert.url_gambar_belakang) {
        if (imgBack) {
          imgBack.src = cert.url_gambar_belakang;
          imgBack.classList.add('hidden');
        }
        transcriptBar?.classList.remove('hidden');
        const btnText = togglePageBtn?.querySelector('#transcript-btn-text');
        if (btnText) {
          btnText.innerHTML = '<span class="lang-id">Lihat Halaman Belakang / Transkrip Nilai</span><span class="lang-en">View Back Page / Grade Transcript</span>';
        }
      } else {
        transcriptBar?.classList.add('hidden');
      }

      document.body.style.overflow = 'hidden';
      dialog.showModal();
    };
  })();
</script>
