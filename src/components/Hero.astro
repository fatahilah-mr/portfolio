---
// src/components/Hero.astro
// Clean, Anti-Slop Hero Section: Official squircle portrait, high-density credentials, no fake badge slop
---

<section id="hero" class="hero-section section-padding">
  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Profile Squircle Avatar Column -->
      <div class="hero-avatar-col">
        <div class="avatar-squircle">
          <img 
            src="/assets/profile.webp" 
            alt="Fatahilah Miftahul Rahman - Official Portrait" 
            width="280" 
            height="280" 
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="avatar-image"
          />
        </div>
      </div>

      <!-- Content Column -->
      <div class="hero-content-col">
        <div class="credential-tag">
          <span class="lang-id">🏆 Juara 1 LKS IT Network System Administration 2026</span>
          <span class="lang-en hidden">🏆 1st Place Winner LKS IT Network System Administration 2026</span>
        </div>

        <h1 class="hero-title">
          Fatahilah Miftahul Rahman
        </h1>

        <p class="hero-subtitle">
          <span class="lang-id">
            Spesialis <strong>Infrastruktur Jaringan Enterprise</strong>, <strong>Administrasi Server Linux</strong>, dan <strong>Pengembang Web Modern</strong>. Berfokus pada arsitektur sistem yang andal, aman, serta otomatisasi alur kerja cerdas.
          </span>
          <span class="lang-en hidden">
            Specialist in <strong>Enterprise Network Infrastructure</strong>, <strong>Linux Server Administration</strong>, and <strong>Modern Web Engineering</strong>. Focused on robust, secure architectures and intelligent automated workflows.
          </span>
        </p>

        <!-- Metrics Bar (Anti-Slop Grounded Proof) -->
        <div class="hero-metrics">
          <div class="metric-item">
            <span class="metric-val">#1</span>
            <span class="metric-lbl">
              <span class="lang-id">LKS Purworejo</span>
              <span class="lang-en hidden">LKS Gold Medalist</span>
            </span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">20+</span>
            <span class="metric-lbl">
              <span class="lang-id">Sertifikat Terverifikasi</span>
              <span class="lang-en hidden">Verified Certs</span>
            </span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-val">10+</span>
            <span class="metric-lbl">
              <span class="lang-id">Proyek Nyata & Lab</span>
              <span class="lang-en hidden">Real Projects & Labs</span>
            </span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">
            <span class="lang-id">Lihat Proyek Unggulan</span>
            <span class="lang-en hidden">Featured Projects</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 18 6-6-6-6"/>
            </svg>
          </a>
          <a href="/assets/CV_Fatahilah_Miftahul_Rahman.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span class="lang-id">Unduh CV Resmi</span>
            <span class="lang-en hidden">Download CV</span>
          </a>
          <a href="#contact" class="btn btn-secondary">
            <span class="lang-id">Kontak</span>
            <span class="lang-en hidden">Contact</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: radial-gradient(circle at top right, var(--bg-surface) 0%, var(--bg-main) 65%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      flex-direction: row;
      text-align: left;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* Squircle Avatar Frame */
  .hero-avatar-col {
    flex-shrink: 0;
  }

  .avatar-squircle {
    width: clamp(200px, 24vw, 280px);
    height: clamp(200px, 24vw, 280px);
    border-radius: 36px;
    background: var(--bg-surface);
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .avatar-squircle:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
  }

  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-content-col {
    flex: 1;
    max-width: 720px;
  }

  .credential-tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border: 1px solid rgba(37, 99, 235, 0.2);
    margin-bottom: 16px;
  }

  .hero-title {
    margin-bottom: 16px;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .hero-subtitle strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  /* Metrics Bar */
  .hero-metrics {
    display: inline-flex;
    align-items: center;
    gap: clamp(16px, 3vw, 28px);
    background: var(--bg-card);
    border: 1px solid var(--color-border);
    padding: 12px clamp(16px, 3vw, 24px);
    border-radius: 12px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-sm);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .metric-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-foreground);
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-subtle);
  }

  .metric-divider {
    width: 1px;
    height: 32px;
    background-color: var(--color-border);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }
</style>
