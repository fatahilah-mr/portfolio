---
// src/components/Navbar.astro
// Modern Editorial Navbar: 3 Main Items (Beranda + dropdown 7 sections, Proyek, Sertifikat) + ID|EN URL Routing + Theme
interface Props {
  lang?: 'en' | 'id';
}

const { lang } = Astro.props;

// Determine current language from prop or URL
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isIndonesian = lang === 'id' || pathname === '/id' || pathname.endsWith('/id');
const currentLang = isIndonesian ? 'id' : 'en';

// Calculate target URL for English version
// /id -> /
// /projects/id -> /projects
// /certificates/id -> /certificates
let targetEnUrl = '/';
if (pathname === '/id') {
  targetEnUrl = '/';
} else if (pathname.endsWith('/id')) {
  targetEnUrl = pathname.slice(0, -3) || '/';
} else {
  targetEnUrl = pathname;
}

// Calculate target URL for Indonesian version
// / -> /id
// /projects -> /projects/id
// /certificates -> /certificates/id
let targetIdUrl = '/id';
if (pathname === '/') {
  targetIdUrl = '/id';
} else if (pathname.endsWith('/id')) {
  targetIdUrl = pathname;
} else {
  targetIdUrl = `${pathname}/id`;
}

// Base navigation URLs based on current language
const homeUrl = isIndonesian ? '/id' : '/';
const projectsUrl = isIndonesian ? '/projects/id' : '/projects';
const certsUrl = isIndonesian ? '/certificates/id' : '/certificates';
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href={homeUrl} class="brand-logo" aria-label="Fatahilah Portfolio">
      <span class="brand-name">FATAHILAH<span class="brand-accent">.MR</span></span>
    </a>

    <!-- Desktop Navigation (3 Items) -->
    <nav class="desktop-nav" aria-label="Navigasi Utama">
      <ul class="nav-menu">
        <!-- Item 1: Beranda with Section Dropdown -->
        <li class="nav-item has-dropdown">
          <a href={`${homeUrl}#hero`} class="nav-link" id="nav-home">
            <span class="lang-id">Beranda</span>
            <span class="lang-en">Home</span>
            <svg class="dropdown-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m6 9 6 6 6-6"/>
            </svg>
          </a>
          <!-- Dropdown Menu for 7 Sections -->
          <div class="dropdown-menu">
            <a href={`${homeUrl}#hero`} class="dropdown-link">
              <span class="lang-id">1. Ringkasan (Hero)</span>
              <span class="lang-en">1. Summary (Hero)</span>
            </a>
            <a href={`${homeUrl}#about`} class="dropdown-link">
              <span class="lang-id">2. Tentang Saya</span>
              <span class="lang-en">2. About Me</span>
            </a>
            <a href={`${homeUrl}#skills`} class="dropdown-link">
              <span class="lang-id">3. Keahlian Teknis</span>
              <span class="lang-en">3. Technical Skills</span>
            </a>
            <a href={`${homeUrl}#experience`} class="dropdown-link">
              <span class="lang-id">4. Pengalaman & Prestasi</span>
              <span class="lang-en">4. Experience & Awards</span>
            </a>
            <a href={`${homeUrl}#projects`} class="dropdown-link">
              <span class="lang-id">5. Proyek Unggulan</span>
              <span class="lang-en">5. Featured Projects</span>
            </a>
            <a href={`${homeUrl}#certificates`} class="dropdown-link">
              <span class="lang-id">6. Sertifikat Pilihan</span>
              <span class="lang-en">6. Top Certificates</span>
            </a>
            <a href={`${homeUrl}#contact`} class="dropdown-link">
              <span class="lang-id">7. Kontak & Diskusi</span>
              <span class="lang-en">7. Contact</span>
            </a>
          </div>
        </li>

        <!-- Item 2: Proyek -->
        <li class="nav-item">
          <a href={projectsUrl} class="nav-link" id="nav-projects">
            <span class="lang-id">Proyek</span>
            <span class="lang-en">Projects</span>
          </a>
        </li>

        <!-- Item 3: Sertifikat -->
        <li class="nav-item">
          <a href={certsUrl} class="nav-link" id="nav-certs">
            <span class="lang-id">Sertifikat</span>
            <span class="lang-en">Certificates</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Actions (ID/EN Switcher, Theme Toggle, Mobile Button) -->
    <div class="header-actions">
      <!-- Language Selector (ID | EN URL Routing) -->
      <div 
        class="lang-btn" 
        role="group"
        aria-label="Ganti Bahasa (Switch Language)"
      >
        <a 
          href={targetIdUrl} 
          class={`lang-code ${isIndonesian ? 'active' : ''}`} 
          id="lang-code-id"
          title="Beralih ke Bahasa Indonesia"
        >ID</a>
        <span class="lang-divider">|</span>
        <a 
          href={targetEnUrl} 
          class={`lang-code ${!isIndonesian ? 'active' : ''}`} 
          id="lang-code-en"
          title="Switch to English"
        >EN</a>
      </div>

      <!-- Theme Switcher -->
      <button 
        id="theme-toggle-btn" 
        class="action-btn" 
        aria-label="Mode Gelap / Terang"
        title="Mode Gelap / Terang"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn" 
        class="action-btn mobile-only" 
        aria-label="Buka Menu" 
        aria-expanded="false" 
        aria-controls="mobile-nav-drawer"
      >
        <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg class="icon-close hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" x2="6" y1="6" y2="18"></line>
          <line x1="6" x2="18" y1="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-nav-drawer" class="mobile-drawer hidden">
    <div class="mobile-drawer-inner container">
      <!-- Section Accordion for Beranda -->
      <div class="mobile-accordion">
        <button class="mobile-accordion-btn" id="mobile-beranda-accordion">
          <span class="lang-id">Beranda (7 Bagian)</span>
          <span class="lang-en">Home (7 Sections)</span>
          <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <div class="mobile-accordion-content" id="mobile-beranda-sublinks">
          <a href={`${homeUrl}#hero`} class="mobile-sublink">1. Hero</a>
          <a href={`${homeUrl}#about`} class="mobile-sublink">2. Tentang Saya</a>
          <a href={`${homeUrl}#skills`} class="mobile-sublink">3. Keahlian Teknis</a>
          <a href={`${homeUrl}#experience`} class="mobile-sublink">4. Pengalaman</a>
          <a href={`${homeUrl}#projects`} class="mobile-sublink">5. Proyek Unggulan</a>
          <a href={`${homeUrl}#certificates`} class="mobile-sublink">6. Sertifikat Pilihan</a>
          <a href={`${homeUrl}#contact`} class="mobile-sublink">7. Kontak</a>
        </div>
      </div>

      <a href={projectsUrl} class="mobile-mainlink">
        <span class="lang-id">Katalog Proyek Lengkap</span>
        <span class="lang-en">Full Projects Catalog</span>
      </a>

      <a href={certsUrl} class="mobile-mainlink">
        <span class="lang-id">Katalog Sertifikat Lengkap</span>
        <span class="lang-en">Full Certificates Catalog</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }

  .brand-accent {
    color: var(--color-accent);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 840px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-muted);
    padding: 8px 4px;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-foreground);
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
  }

  /* Dropdown Menu */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 230px;
    background: var(--bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    box-shadow: var(--shadow-lg);
    padding: 8px;
    display: none;
    flex-direction: column;
    gap: 2px;
    z-index: 1050;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    display: flex;
  }

  .has-dropdown:hover .dropdown-chevron {
    transform: rotate(180deg);
  }

  .dropdown-link {
    display: block;
    padding: 8px 12px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .dropdown-link:hover {
    color: var(--color-foreground);
    background-color: var(--bg-surface);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Language Switcher */
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 8px;
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    font-size: 0.8125rem;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .lang-btn:hover {
    border-color: var(--color-border-hover);
  }

  .lang-code {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lang-code:hover {
    color: var(--color-foreground);
  }

  .lang-code.active {
    color: var(--color-accent);
    font-weight: 700;
  }

  .lang-divider {
    opacity: 0.4;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Action Buttons */
  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .action-btn:hover {
    color: var(--color-foreground);
    background: var(--bg-surface);
    border-color: var(--color-border-hover);
  }

  /* Theme icon swapping */
  :global([data-theme="dark"]) .icon-sun { display: block; }
  :global([data-theme="dark"]) .icon-moon { display: none; }
  :global([data-theme="light"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: block; }

  .mobile-only {
    display: inline-flex;
  }

  @media (min-width: 840px) {
    .mobile-only {
      display: none !important;
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    border-top: 1px solid var(--color-border);
    background: var(--bg-card);
    padding: 16px 0 24px 0;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mobile-mainlink {
    display: block;
    padding: 10px 14px;
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-foreground);
    border-radius: 8px;
    background: var(--bg-surface);
  }

  .mobile-accordion {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .mobile-accordion-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--bg-surface);
    border: none;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .mobile-accordion-content {
    display: flex;
    flex-direction: column;
    padding: 8px 14px;
    gap: 6px;
    background: var(--bg-card);
  }

  .mobile-accordion-content.hidden {
    display: none;
  }

  .mobile-sublink {
    padding: 6px 8px;
    font-size: 0.9rem;
    color: var(--color-muted);
    border-radius: 4px;
  }

  .mobile-sublink:hover {
    color: var(--color-accent);
    background: var(--bg-surface);
  }

  .hidden {
    display: none !important;
  }
</style>

<script is:inline>
  // Theme switcher setup
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle-btn');
    btn?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  }

  // Mobile drawer and accordion setup
  function setupMobileDrawer() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-nav-drawer');
    const iconMenu = menuBtn?.querySelector('.icon-menu');
    const iconClose = menuBtn?.querySelector('.icon-close');

    menuBtn?.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      drawer?.classList.toggle('hidden', isExpanded);
      iconMenu?.classList.toggle('hidden', !isExpanded);
      iconClose?.classList.toggle('hidden', isExpanded);
    });

    const accordionBtn = document.getElementById('mobile-beranda-accordion');
    const sublinks = document.getElementById('mobile-beranda-sublinks');
    const chevron = accordionBtn?.querySelector('.accordion-chevron');

    accordionBtn?.addEventListener('click', () => {
      const isHidden = sublinks?.classList.toggle('hidden');
      if (chevron) {
        chevron.style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });

    // Close drawer when any sublink is clicked
    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.add('hidden');
        menuBtn?.setAttribute('aria-expanded', 'false');
        iconMenu?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupThemeToggle();
    setupMobileDrawer();
  });
</script>
