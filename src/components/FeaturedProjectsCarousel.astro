---
// src/components/FeaturedProjectsCarousel.astro
// 3D Centered Carousel with Top 3 Web Projects (1440x900 / 16:10), animated micro-indicator, and modal trigger
import projectsData from '../data/projects.json';

interface Props {
  lang?: 'en' | 'id';
}

const { lang = 'en' } = Astro.props;
const catalogUrl = lang === 'id' ? '/projects/id' : '/projects';

// Top 3 featured projects: PERISAI Temon (ID: 2), PERISAI AYOM (ID: 3), FATAH Gateway (ID: 5)
const featuredProjects = [
  projectsData.find(p => p.id === '2'),
  projectsData.find(p => p.id === '3'),
  projectsData.find(p => p.id === '5')
].filter(Boolean);
---

<section id="projects" class="section-padding featured-projects-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">
        <span class="lang-id">Proyek Unggulan</span>
        <span class="lang-en hidden">Featured Projects</span>
      </span>
      <h2 class="section-title">
        <span class="lang-id">Karya & Rekayasa Web Pilihan</span>
        <span class="lang-en hidden">Curated Engineering Showcase</span>
      </h2>
      <p class="section-subtitle">
        <span class="lang-id">
          Platform web produksi nyata dengan integrasi AI cerdas, arsitektur serverless, dan kinerja ultra-responsif.
        </span>
        <span class="lang-en hidden">
          Real production web applications featuring intelligent AI integration, serverless edge hosting, and ultra-fast performance.
        </span>
      </p>
    </div>

    <!-- 3D Centered Carousel Stage -->
    <div class="carousel-stage" id="project-carousel-stage">
      <div class="carousel-viewport" id="project-carousel-viewport" role="region" aria-label="Galeri Proyek Unggulan">
        {featuredProjects.map((proj, idx) => {
          let posClass = 'hidden-card';
          if (idx === 0) posClass = 'active';
          else if (idx === 1) posClass = 'next';
          else if (idx === 2) posClass = 'prev';

          return (
            <div 
              class={`carousel-card ${posClass}`} 
              data-index={idx}
              data-project={JSON.stringify(proj)}
              role="button"
              tabindex="0"
              aria-label={`Lihat detail proyek ${proj.judul}`}
            >
              <!-- Aspect Ratio 1440x900 (16:10) -->
              <div class="aspect-16-10">
                <img 
                  src={proj.link_gambar} 
                  alt={proj.judul} 
                  loading="lazy" 
                  decoding="async" 
                  width="1440" 
                  height="900"
                />
              </div>

              <!-- Animated Click-Here Micro Indicator (on active card) -->
              {idx === 0 && (
                <div class="carousel-hint-indicator" id="project-click-hint">
                  <span class="lang-id">👆 Klik di sini untuk detail</span>
                  <span class="lang-en hidden">👆 Click here for details</span>
                </div>
              )}

              <!-- Card Info Footer -->
              <div class="carousel-card-footer">
                <div class="footer-meta">
                  <span class="footer-category">{proj.kategori}</span>
                  <h3 class="footer-title">
                    <span class="lang-id">{proj.judul}</span>
                    <span class="lang-en hidden">{proj.english_title || proj.judul}</span>
                  </h3>
                </div>
                <div class="footer-arrow">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17 17 7M7 7h10v10"/>
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Carousel Navigation Controls -->
      <div class="carousel-controls">
        <button id="proj-prev-btn" class="carousel-arrow-btn" aria-label="Proyek Sebelumnya">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>

        <div class="carousel-dots" id="proj-dots">
          {featuredProjects.map((_, i) => (
            <button class={`carousel-dot ${i === 0 ? 'active' : ''}`} data-dot-index={i} aria-label={`Slide ${i + 1}`}></button>
          ))}
        </div>

        <button id="proj-next-btn" class="carousel-arrow-btn" aria-label="Proyek Berikutnya">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Catalog CTA -->
    <div class="carousel-view-all">
      <a href={catalogUrl} class="btn btn-secondary">
        <span class="lang-id">Lihat Semua Proyek Lengkap (10+)</span>
        <span class="lang-en hidden">View All Projects (10+)</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .featured-projects-section {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .carousel-card-footer {
    padding: 16px 20px;
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--color-border);
  }

  .footer-meta {
    max-width: 85%;
  }

  .footer-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 2px;
  }

  .footer-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .footer-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .carousel-view-all {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-top: 32px;
    padding: 0 16px;
    box-sizing: border-box;
  }

  .carousel-view-all .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 24px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--bg-card);
    color: var(--color-foreground) !important;
    box-shadow: var(--shadow-sm);
    max-width: 100%;
    text-align: center;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .carousel-view-all .btn:hover {
    border-color: var(--color-border-hover);
    background: var(--bg-card-hover);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .carousel-view-all .btn {
      width: 100%;
      max-width: 320px;
      padding: 11px 16px;
      font-size: 0.875rem;
      white-space: normal;
    }
  }
</style>

<script is:inline>
  (function initProjectCarousel() {
    const stage = document.getElementById('project-carousel-stage');
    if (!stage) return;

    const cards = Array.from(stage.querySelectorAll('.carousel-card'));
    const dots = Array.from(stage.querySelectorAll('.carousel-dot'));
    const prevBtn = document.getElementById('proj-prev-btn');
    const nextBtn = document.getElementById('proj-next-btn');
    const hint = document.getElementById('project-click-hint');

    let currentIndex = 0;
    let autoPlayTimer = null;
    let hasInteracted = false;

    function fadeOutHint() {
      if (!hasInteracted && hint) {
        hint.classList.add('faded');
        hasInteracted = true;
      }
    }

    function updateCarousel(newIndex) {
      currentIndex = (newIndex + cards.length) % cards.length;

      cards.forEach((card, idx) => {
        card.classList.remove('active', 'prev', 'next', 'hidden-card');
        const diff = (idx - currentIndex + cards.length) % cards.length;

        if (diff === 0) {
          card.classList.add('active');
        } else if (diff === 1) {
          card.classList.add('next');
        } else if (diff === cards.length - 1) {
          card.classList.add('prev');
        } else {
          card.classList.add('hidden-card');
        }
      });

      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === currentIndex);
      });
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        updateCarousel(currentIndex + 1);
      }, 5000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    // Event listeners for controls
    prevBtn?.addEventListener('click', () => {
      fadeOutHint();
      updateCarousel(currentIndex - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      fadeOutHint();
      updateCarousel(currentIndex + 1);
      startAutoPlay();
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        fadeOutHint();
        updateCarousel(i);
        startAutoPlay();
      });
    });

    // Hover pauses auto-rotation
    stage.addEventListener('mouseenter', stopAutoPlay);
    stage.addEventListener('mouseleave', startAutoPlay);

    // Card clicks: if center, open modal; if side, navigate to that card
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        fadeOutHint();
        if (idx === currentIndex) {
          // Open detail modal
          const projData = JSON.parse(card.getAttribute('data-project') || '{}');
          if (window.openProjectModal) {
            window.openProjectModal(projData);
          }
        } else {
          updateCarousel(idx);
          startAutoPlay();
        }
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          card.click();
        }
      });
    });

    // Touch swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    stage.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 50) {
        fadeOutHint();
        updateCarousel(currentIndex + 1);
      } else if (touchEndX - touchStartX > 50) {
        fadeOutHint();
        updateCarousel(currentIndex - 1);
      }
      startAutoPlay();
    }, { passive: true });

    // Initial state
    updateCarousel(0);
    startAutoPlay();
  })();
</script>
