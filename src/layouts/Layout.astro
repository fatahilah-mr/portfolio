---
// src/layouts/Layout.astro
// Modern Editorial Layout with A11y, Anti-Slop tokens, and Universal Detail Modal
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DetailModal from '../components/DetailModal.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'id';
  image?: string;
}

const { 
  title, 
  description = "Portofolio resmi Fatahilah Miftahul Rahman - Juara 1 LKS IT Network System Administration Purworejo 2026. Menampilkan keahlian infrastruktur jaringan enterprise, administrasi server Linux, proyek web produksi publik, dan kredensial terverifikasi.",
  lang = 'id',
  image = "https://cdn.fmr.web.id/og-image-fatahmr.my.id.png"
} = Astro.props;

// Determine target URLs for hreflang & SEO
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
let targetIdUrl = '/';
if (pathname === '/en' || pathname === '/id') {
  targetIdUrl = '/';
} else if (pathname.startsWith('/en/')) {
  targetIdUrl = pathname.replace(/^\/en/, '') || '/';
} else if (pathname.endsWith('/id')) {
  targetIdUrl = pathname.slice(0, -3) || '/';
} else {
  targetIdUrl = pathname;
}

let targetEnUrl = '/en';
if (pathname === '/' || pathname === '/id') {
  targetEnUrl = '/en';
} else if (pathname.startsWith('/en')) {
  targetEnUrl = pathname;
} else if (pathname.endsWith('/id')) {
  const base = pathname.slice(0, -3) || '/';
  targetEnUrl = base === '/' ? '/en' : `/en${base}`;
} else {
  targetEnUrl = `/en${pathname}`;
}

const formattedTitle = title.includes('Fatahilah Miftahul Rahman') ? title : `${title} | Fatahilah Miftahul Rahman`;
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Fatahilah Miftahul Rahman" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <title>{formattedTitle}</title>

  <!-- Canonical URL -->
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  <!-- Alternate Multilingual URLs for SEO (Google Best Practice) -->
  <link rel="alternate" hreflang="id" href={new URL(targetIdUrl, Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(targetEnUrl, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={formattedTitle} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={image} />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Fatahilah Miftahul Rahman",
    "url": "https://fatahmr.my.id",
    "image": "https://cdn.fatah.web.id/portfolio/assets/profile.webp",
    "jobTitle": "IT Network System Administration & Web Development Specialist",
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "SMK Patriot Pituruh"
    },
    "award": [
      "Juara 1 Lomba Kompetensi Siswa (LKS) IT Network System Administration Kabupaten Purworejo 2026",
      "Peserta LKS SMK Tingkat Provinsi Jawa Tengah ke-XXXIV 2026"
    ],
    "knowsAbout": [
      "IT Network System Administration",
      "Cisco Networking & Switching",
      "MikroTik RouterOS & Hotspot Gateway",
      "FTTH & Fiber Optic Splicing",
      "Linux Server Administration (Debian 12 & 13)",
      "Windows Server 2022 & AD DS",
      "Web Development (Astro 5, Next.js, React, Tailwind CSS)",
      "Cloudflare Pages, D1, R2 & Serverless Functions"
    ],
    "sameAs": [
      "https://github.com/fatahilah-mr",
      "https://www.linkedin.com/in/fatahilah-miftahul-rahman"
    ]
  })} />

  <!-- Google Fonts Preload: JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Anti-FOUC Theme Init Script -->
  <script is:inline>
    (function() {
      try {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        console.warn('Theme init warning:', e);
      }
    })();
  </script>

  <!-- Client-Side Language/Region Auto-Detect (First Visit Outside ID -> /en) -->
  <script is:inline>
    (function() {
      try {
        const path = window.location.pathname.replace(/\/$/, '') || '/';
        const pref = localStorage.getItem('preferred_lang');

        // Only trigger auto-detect on the root page ('/')
        if (path === '/') {
          if (pref === 'en') {
            window.location.replace('/en');
            return;
          }
          if (!pref) {
            // Check browser preferred languages
            const navLangs = navigator.languages || [navigator.language || navigator.userLanguage || ''];
            const isIndonesian = Array.from(navLangs).some(function(l) {
              return l && l.toLowerCase().startsWith('id');
            });
            if (!isIndonesian) {
              // User is from outside Indonesia / has non-ID browser language -> redirect to /en
              localStorage.setItem('preferred_lang', 'en');
              document.cookie = 'preferred_lang=en; path=/; max-age=31536000; SameSite=Lax';
              window.location.replace('/en');
              return;
            } else {
              localStorage.setItem('preferred_lang', 'id');
              document.cookie = 'preferred_lang=id; path=/; max-age=31536000; SameSite=Lax';
            }
          }
        } else if (path === '/en' || path.startsWith('/en/')) {
          if (!pref) {
            localStorage.setItem('preferred_lang', 'en');
            document.cookie = 'preferred_lang=en; path=/; max-age=31536000; SameSite=Lax';
          }
        }
      } catch (e) {
        console.warn('Language auto-detect warning:', e);
      }
    })();
  </script>

  <!-- Progressive Enhancement: Full visibility fallback for No-JS & Web Crawlers -->
  <noscript>
    <style>
      .reveal-on-scroll {
        opacity: 1 !important;
        transform: none !important;
      }
    </style>
  </noscript>
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="skip-to-content sr-only focus:not-sr-only">
    {lang === 'id' ? 'Langsung ke konten utama' : 'Skip to main content'}
  </a>

  <!-- ARIA Live Announcer -->
  <div id="a11y-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <!-- Main Navigation -->
  <Navbar lang={lang} />

  <!-- Main Content -->
  <main id="main-content" tabindex="-1" class="main-wrapper">
    <slot />
  </main>

  <!-- Universal Detail Modal Pop-up -->
  <DetailModal />

  <!-- Footer -->
  <Footer lang={lang} />

  <style>
    .skip-to-content:focus {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 9999;
      background-color: var(--color-primary);
      color: #FFFFFF;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 700;
      box-shadow: var(--shadow-lg);
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      outline: none;
    }
  </style>

  <!-- Lightweight Editorial Scroll Reveal Engine (60fps, 0-KB Deps, Anti-Slop) -->
  <script is:inline>
    (function initScrollReveal() {
      function runReveal() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealElements = document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)');
        if (revealElements.length === 0) return;

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          revealElements.forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target); // One-time reveal: immediately disconnect
            }
          });
        }, {
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.08
        });

        revealElements.forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runReveal);
      } else {
        runReveal();
      }
    })();
  </script>
</body>
</html>
