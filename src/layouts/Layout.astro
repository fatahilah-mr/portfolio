---
// src/layouts/Layout.astro
// Modern Editorial Layout with A11y, Anti-Slop tokens, and Universal Detail Modal
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DetailModal from '../components/DetailModal.astro';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'id';
}

const { 
  title, 
  description = "Fatahilah Miftahul Rahman Portfolio - 1st Place Winner LKS IT Network System Administration 2026. Specialist in enterprise network infrastructure, Linux servers, and modern web engineering.",
  lang = 'en'
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="author" content="Fatahilah Miftahul Rahman" />
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
  <title>{title} | Fatahilah Miftahul Rahman</title>

  <!-- Canonical URL -->
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={`${title} | Fatahilah Miftahul Rahman`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://cdn.fatahmr.my.id/portfolio/assets/profile.webp" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={`${title} | Fatahilah Miftahul Rahman`} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="https://cdn.fatahmr.my.id/portfolio/assets/profile.webp" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Fatahilah Miftahul Rahman",
    "url": "https://fatahmr.my.id",
    "image": "https://cdn.fatahmr.my.id/portfolio/assets/profile.webp",
    "jobTitle": "IT Network System Administration & Web Development Specialist",
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "SMK Patriot Pituruh"
    },
    "award": [
      "Juara 1 Lomba Kompetensi Siswa (LKS) IT Network System Administration Kabupaten Purworejo 2026",
      "Peserta LKS SMK Tingkat Provinsi Jawa Tengah ke-XXXIV 2026"
    ],
    "knowsAbout": [
      "IT Network System Administration",
      "Cisco Networking & Switching",
      "MikroTik RouterOS & Hotspot Gateway",
      "Linux Server Administration (Debian 12)",
      "Windows Server 2022 & ADDS",
      "Web Development (Astro 5, Next.js, React, Tailwind CSS)",
      "Cloudflare Pages, D1, R2 & Serverless Functions"
    ],
    "sameAs": [
      "https://github.com/fatahilah-mr",
      "https://www.linkedin.com/in/fatahilah-miftahul-rahman"
    ]
  })} />

  <!-- Google Fonts Preload: JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Anti-FOUC Theme Init Script -->
  <script is:inline>
    (function() {
      try {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {
        console.warn('Theme init warning:', e);
      }
    })();
  </script>
</head>
<body>
  <!-- Accessible Skip Link -->
  <a href="#main-content" class="skip-to-content sr-only focus:not-sr-only">
    {lang === 'id' ? 'Langsung ke konten utama' : 'Skip to main content'}
  </a>

  <!-- ARIA Live Announcer -->
  <div id="a11y-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

  <!-- Main Navigation -->
  <Navbar lang={lang} />

  <!-- Main Content -->
  <main id="main-content" tabindex="-1" class="main-wrapper">
    <slot />
  </main>

  <!-- Universal Detail Modal Pop-up -->
  <DetailModal />

  <!-- Footer -->
  <Footer lang={lang} />

  <style>
    .skip-to-content:focus {
      position: fixed;
      top: 16px;
      left: 16px;
      z-index: 9999;
      background-color: var(--color-primary);
      color: #FFFFFF;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 700;
      box-shadow: var(--shadow-lg);
    }

    .main-wrapper {
      flex: 1;
      display: flex;
      flex-direction: column;
      outline: none;
    }
  </style>
</body>
</html>
